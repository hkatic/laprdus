# Maintainer: Hrvoje Katic <hrvoje.katic@gmail.com>

pkgname=laprdus
pkgver=2.0.0
pkgrel=1
pkgdesc="Croatian/Serbian/Bosnian/Slovenian Text-to-Speech Engine"
arch=('x86_64' 'aarch64')
url="https://hrvojekatic.com/laprdus"
license=('GPL3')
# The programs are Rust and link only the C library, libgcc and, for the
# CLI's playback, ALSA (which PulseAudio and PipeWire serve too). The Speech
# Dispatcher module talks to the server through its standard streams and
# links none of its libraries.
depends=('glibc' 'gcc-libs' 'alsa-lib' 'speech-dispatcher')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.xz"
        'laprdus.install')
sha256sums=('SKIP'
            'SKIP')
install=laprdus.install

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    # The voice data and dictionaries (data/voices, data/dictionary), then
    # the CLI, the Speech Dispatcher module and the C API library.
    cargo --frozen xtask build --frozen
}

package() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable

    # The library (liblaprdus.so.2.0.0 and its links), the CLI, the header,
    # the voice data and dictionaries, the Speech Dispatcher module and its
    # configuration. Everything is built already; this only copies.
    cargo --frozen xtask install --frozen --destdir "$pkgdir" --prefix /usr

    # Install documentation
    install -Dm644 readme.md "$pkgdir/usr/share/doc/$pkgname/readme.md"
}
