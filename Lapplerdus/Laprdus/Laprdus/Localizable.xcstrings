          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nižje vrednosti dodajo daljše premore za vsakim znakom. Znaki se vedno izgovarjajo z običajno hitrostjo govora. 100% ne doda premora; privzeto je 50%."
