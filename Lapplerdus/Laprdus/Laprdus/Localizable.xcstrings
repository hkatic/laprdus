    "Lower values add longer pauses after each character. Characters always use the normal speech rate. 100% adds no extra pause; default 50%." : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niže vrijednosti produljuju pauze nakon svakog znaka. Znakovi se uvijek izgovaraju uobičajenom brzinom govora. 100% ne dodaje pauzu; zadano je 50%."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
