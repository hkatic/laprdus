<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>AudioComponents</key>
			<array>
				<dict>
					<key>description</key>
					<string>Laprdus Croatian/Serbian speech synthesizer</string>
					<key>manufacturer</key>
					<string>HKTC</string>
					<key>name</key>
					<string>Laprdus: Laprdus Voices</string>
					<key>subtype</key>
					<string>lprd</string>
					<key>tags</key>
					<array>
						<string>Speech Synthesizer</string>
					</array>
					<key>type</key>
					<string>ausp</string>
					<!-- Bump whenever the exposed voice list or voice names
					     change: the system caches them per component version,
					     so without this an update keeps serving old names. -->
					<key>version</key>
					<integer>2</integer>
				</dict>
			</array>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.AudioUnit</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).LaprdusAudioUnitFactory</string>
	</dict>
</dict>
</plist>
