// -*- coding: utf-8 -*-
// laprdus_config.rc - LaprdusTTS configuration GUI resources

#include <windows.h>
#include <commctrl.h>
#include "resource.h"

// Tell the resource compiler this file is UTF-8 encoded
#pragma code_page(65001)

// Application manifest for visual styles and DPI awareness
1 RT_MANIFEST "laprdus_config.manifest"

// The dialog templates are shared by every language (all their text is set from
// the string tables at run time), so they carry no language of their own.
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// =============================================================================
// Dialog Template
// =============================================================================

IDD_CONFIG_DIALOG DIALOGEX 0, 0, 320, 492
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LaprdusTTS Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    // Voice Settings Group: rate and acceleration, pitch and inflection, volume,
    // and the button of the voice quality dialog
    GROUPBOX        "", IDC_GROUP_VOICE, 7, 7, 306, 217

    LTEXT           "Voice:", IDC_VOICE_LABEL, 14, 22, 50, 8
    COMBOBOX        IDC_VOICE_COMBO, 70, 20, 180, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Speed:", IDC_SPEED_LABEL, 14, 42, 50, 8
    CONTROL         "", IDC_SPEED_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 70, 40, 180, 18
    LTEXT           "1.0x", IDC_SPEED_VALUE, 260, 42, 40, 8
    AUTOCHECKBOX    "", IDC_FORCE_SPEED, 14, 58, 290, 10, WS_TABSTOP

    LTEXT           "Acceleration:", IDC_ACCELERATION_LABEL, 14, 75, 60, 8
    CONTROL         "", IDC_ACCELERATION_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 80, 73, 130, 18
    LTEXT           "1.0x", IDC_ACCELERATION_VALUE, 216, 75, 94, 8

    LTEXT           "Pitch:", IDC_PITCH_LABEL, 14, 98, 50, 8
    CONTROL         "", IDC_PITCH_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 70, 96, 180, 18
    LTEXT           "1.0x", IDC_PITCH_VALUE, 260, 98, 40, 8
    AUTOCHECKBOX    "", IDC_FORCE_PITCH, 14, 114, 290, 10, WS_TABSTOP

    LTEXT           "Inflection:", IDC_INFLECTION_LABEL, 14, 131, 60, 8
    CONTROL         "", IDC_INFLECTION_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 80, 129, 130, 18
    LTEXT           "50%", IDC_INFLECTION_VALUE, 216, 131, 94, 8

    LTEXT           "Volume:", IDC_VOLUME_LABEL, 14, 154, 50, 8
    CONTROL         "", IDC_VOLUME_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 70, 152, 180, 18
    LTEXT           "100%", IDC_VOLUME_VALUE, 260, 154, 40, 8
    AUTOCHECKBOX    "", IDC_FORCE_VOLUME, 14, 170, 290, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_VOLUME_BOOST_CHECK, 14, 185, 290, 10, WS_TABSTOP

    // Head size, breathiness, roughness and brightness have a dialog of their own
    PUSHBUTTON      "", IDC_VOICE_QUALITY_BUTTON, 14, 199, 120, 14, WS_TABSTOP

    // Pause Settings Group
    GROUPBOX        "", IDC_GROUP_PAUSES, 7, 229, 306, 113

    LTEXT           "Comma pause:", IDC_COMMA_LABEL, 14, 244, 80, 8
    CONTROL         "", IDC_COMMA_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 242, 150, 18
    LTEXT           "100 ms", IDC_COMMA_VALUE, 260, 244, 40, 8

    LTEXT           "Sentence pause:", IDC_SENTENCE_LABEL, 14, 267, 80, 8
    CONTROL         "", IDC_SENTENCE_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 265, 150, 18
    LTEXT           "100 ms", IDC_SENTENCE_VALUE, 260, 267, 40, 8

    LTEXT           "Newline pause:", IDC_NEWLINE_LABEL, 14, 290, 80, 8
    CONTROL         "", IDC_NEWLINE_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 288, 150, 18
    LTEXT           "100 ms", IDC_NEWLINE_VALUE, 260, 290, 40, 8

    LTEXT           "Spelling speed:", IDC_SPELLING_SPEED_LABEL, 14, 313, 80, 8
    CONTROL         "", IDC_SPELLING_SPEED_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 311, 150, 18
    LTEXT           "50%", IDC_SPELLING_SPEED_VALUE, 260, 313, 40, 8

    // Options Group
    GROUPBOX        "", IDC_GROUP_OPTIONS, 7, 347, 306, 61

    AUTOCHECKBOX    "", IDC_EMOJI_CHECK, 14, 362, 290, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_DIGITS_CHECK, 14, 377, 290, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SPELLING_SOUNDS_CHECK, 14, 392, 290, 10, WS_TABSTOP

    // Dictionaries Group
    GROUPBOX        "", IDC_GROUP_DICTIONARIES, 7, 413, 306, 40

    AUTOCHECKBOX    "", IDC_USER_DICT_CHECK, 14, 428, 170, 10, WS_TABSTOP
    PUSHBUTTON      "", IDC_DICT_BUTTON, 213, 426, 90, 14, WS_TABSTOP

    // Buttons
    PUSHBUTTON      "Test", IDC_TEST_BUTTON, 7, 471, 60, 14, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 140, 471, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 471, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Apply", IDC_APPLY_BUTTON, 252, 471, 50, 14, WS_TABSTOP
END

// =============================================================================
// Voice Quality Dialog
// Head size, breathiness, roughness and brightness (0-100 each, 50 = the voice
// as it is), after the voice-parameter model of a classic formant synthesizer. Every text is set at run time
// from the string tables; each label stands right before its slider so that
// its access key reaches the slider.
// =============================================================================

IDD_VOICE_QUALITY_DIALOG DIALOGEX 0, 0, 320, 154
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Voice quality"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "", IDC_VOICE_QUALITY_HELP, 14, 7, 292, 24

    LTEXT           "Head size:", IDC_HEAD_SIZE_LABEL, 14, 38, 80, 8
    CONTROL         "", IDC_HEAD_SIZE_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 36, 150, 18
    LTEXT           "50%", IDC_HEAD_SIZE_VALUE, 260, 38, 40, 8

    LTEXT           "Breathiness:", IDC_BREATHINESS_LABEL, 14, 61, 80, 8
    CONTROL         "", IDC_BREATHINESS_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 59, 150, 18
    LTEXT           "50%", IDC_BREATHINESS_VALUE, 260, 61, 40, 8

    LTEXT           "Roughness:", IDC_ROUGHNESS_LABEL, 14, 84, 80, 8
    CONTROL         "", IDC_ROUGHNESS_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 82, 150, 18
    LTEXT           "50%", IDC_ROUGHNESS_VALUE, 260, 84, 40, 8

    LTEXT           "Brightness:", IDC_BRIGHTNESS_LABEL, 14, 107, 80, 8
    CONTROL         "", IDC_BRIGHTNESS_SLIDER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 105, 150, 18
    LTEXT           "50%", IDC_BRIGHTNESS_VALUE, 260, 107, 40, 8

    PUSHBUTTON      "", IDC_VOICE_QUALITY_RESTORE, 7, 133, 110, 14, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 207, 133, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 263, 133, 50, 14, WS_TABSTOP
END

// =============================================================================
// Dictionary Management Dialog
// =============================================================================

IDD_DICTIONARY_DIALOG DIALOGEX 0, 0, 400, 320
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rječnici"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "", IDC_DICT_TYPE_LABEL, 7, 10, 80, 8
    COMBOBOX        IDC_DICT_TYPE_COMBO, 90, 8, 180, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_DICT_LISTVIEW, WC_LISTVIEWW, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 28, 386, 252
    PUSHBUTTON      "", IDC_DICT_ADD, 7, 290, 60, 14, WS_TABSTOP
    PUSHBUTTON      "", IDC_DICT_EDIT, 73, 290, 60, 14, WS_TABSTOP
    PUSHBUTTON      "", IDC_DICT_DUPLICATE, 139, 290, 70, 14, WS_TABSTOP
    PUSHBUTTON      "", IDC_DICT_DELETE, 215, 290, 60, 14, WS_TABSTOP
    PUSHBUTTON      "", IDC_DICT_CLOSE, 333, 290, 60, 14, WS_TABSTOP
END

// =============================================================================
// Dictionary Entry Editor Dialog
// =============================================================================

IDD_DICT_ENTRY_DIALOG DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dodaj unos"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "", IDC_ENTRY_ORIGINAL_LABEL, 7, 10, 100, 8
    EDITTEXT        IDC_ENTRY_ORIGINAL_EDIT, 7, 22, 286, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_ENTRY_REPLACEMENT_LABEL, 7, 42, 100, 8
    EDITTEXT        IDC_ENTRY_REPLACEMENT_EDIT, 7, 54, 286, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_ENTRY_COMMENT_LABEL, 7, 74, 250, 8
    EDITTEXT        IDC_ENTRY_COMMENT_EDIT, 7, 86, 286, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "", IDC_ENTRY_CASE_SENSITIVE, 7, 110, 200, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_ENTRY_WHOLE_WORD, 7, 125, 200, 10, WS_TABSTOP
    DEFPUSHBUTTON   "U redu", IDOK, 186, 165, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Odustani", IDCANCEL, 243, 165, 50, 14, WS_TABSTOP
END

// =============================================================================
// Accent Lexicon Entry Editor Dialog
// =============================================================================

IDD_ACCENT_ENTRY_DIALOG DIALOGEX 0, 0, 300, 226
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dodaj unos"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "", IDC_ACCENT_ENTRY_LABEL, 7, 10, 286, 8
    EDITTEXT        IDC_ACCENT_ENTRY_EDIT, 7, 22, 286, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_ACCENT_KIND_LABEL, 7, 42, 130, 8
    COMBOBOX        IDC_ACCENT_KIND_COMBO, 7, 54, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_ACCENT_LANG_LABEL, 150, 42, 143, 8
    COMBOBOX        IDC_ACCENT_LANG_COMBO, 150, 54, 143, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_ACCENT_COMMENT_LABEL, 7, 74, 286, 8
    EDITTEXT        IDC_ACCENT_COMMENT_EDIT, 7, 86, 286, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_ACCENT_HELP, 7, 108, 286, 84
    DEFPUSHBUTTON   "U redu", IDOK, 186, 203, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Odustani", IDCANCEL, 243, 203, 50, 14, WS_TABSTOP
END

// =============================================================================
// English Strings
// The language of every Windows display language without a table of its own.
// The Test button speaks Croatian then (Laprdus does not speak English), hence its text.
// =============================================================================

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_APP_TITLE               "LaprdusTTS Settings"
    IDS_GROUP_VOICE             "Voice Settings"
    IDS_VOICE_LABEL             "&Voice:"
    IDS_SPEED_LABEL             "&Speed:"
    IDS_FORCE_SPEED             "Force Laprdus speech speed for all applications"
    IDS_PITCH_LABEL             "&Pitch:"
    IDS_FORCE_PITCH             "Force Laprdus speech pitch for all applications"
    IDS_VOLUME_LABEL            "Volume:"
    IDS_FORCE_VOLUME            "Force Laprdus speech volume for all applications"
    IDS_VOLUME_BOOST            "Boost speech volume (for noisy places)"
    IDS_GROUP_PAUSES            "Pause Settings"
    IDS_COMMA_LABEL             "Comma pause:"
    IDS_SENTENCE_LABEL          "Sentence pause:"
    IDS_NEWLINE_LABEL           "Newline pause:"
    IDS_GROUP_OPTIONS           "Options"
    IDS_EMOJI                   "Speak &emoji"
    IDS_DIGITS                  "Read numbers digit by di&git"
    IDS_TEST                    "&Test"
    IDS_OK                      "OK"
    IDS_CANCEL                  "Cancel"
    IDS_APPLY                   "Apply"
    IDS_VALUE_SPEED             "%.1fx"
    IDS_VALUE_PERCENT           "%d%%"
    IDS_VALUE_MS                "%d ms"
    IDS_DECIMAL_SEPARATOR       "."
    IDS_INFLECTION_LABEL        "In&flection:"
    IDS_ACCELERATION_LABEL      "Acce&leration:"
    IDS_VALUE_WPM               "%.1fx (up to %d WPM)"
    IDS_SPELLING_SPEED_LABEL    "Spelling speed:"
    IDS_SPELLING_SOUNDS         "Spell letters by their s&ounds (b, c, d) instead of their names (be, ce, de)"
    // Voice quality dialog (head size, breathiness, roughness, brightness)
    IDS_VOICE_QUALITY_BUTTON    "Voice &quality..."
    IDS_VOICE_QUALITY_TITLE     "Voice quality"
    IDS_VOICE_QUALITY_HELP      "0 to 100, 50 is the voice as it is. Head size and brightness work for every voice, breathiness and roughness for the voices synthesized by rule."
    IDS_HEAD_SIZE_LABEL         "&Head size:"
    IDS_BREATHINESS_LABEL       "&Breathiness:"
    IDS_ROUGHNESS_LABEL         "&Roughness:"
    IDS_BRIGHTNESS_LABEL        "Bri&ghtness:"
    IDS_VOICE_QUALITY_RESTORE   "Restore &defaults"
    IDS_VOICE_KIND_RECORDED     "recorded voice"
    IDS_VOICE_KIND_CHILD        "child"
    IDS_VOICE_KIND_GRANDMA      "grandma"
    IDS_VOICE_KIND_GRANDPA      "grandpa"
    IDS_VOICE_KIND_FORMANT      "formant voice"
    IDS_VOICE_KIND_SINGING      "sings"
    IDS_VOICE_DEFAULT           "default"
    IDS_VOICE_NOTE              "Every voice speaks Croatian, Serbian, Bosnian and Slovenian; the speaking application picks the language (SAPI5 voice Laprdus Croatian, Serbian, Bosnian or Slovenian)."
    IDS_TEST_TEXT               "Dobar dan! Ovo je test Laprdus govorne sinteze."
    // Dictionary dialog strings
    IDS_USER_DICT_CHECK         "Apply user dictionaries"
    IDS_DICT_BUTTON             "&Dictionaries..."
    IDS_DICT_DIALOG_TITLE       "Dictionary Management"
    IDS_DICT_TYPE_LABEL         "Dictionary type:"
    IDS_DICT_TYPE_MAIN          "Main user dictionary"
    IDS_DICT_TYPE_SPELLING      "Spelling dictionary"
    IDS_DICT_TYPE_EMOJI         "Emoji dictionary"
    IDS_DICT_COL_ORIGINAL       "Original"
    IDS_DICT_COL_REPLACEMENT    "Replacement"
    IDS_DICT_COL_CASE           "Case sensitive"
    IDS_DICT_COL_WHOLE_WORD     "Whole word"
    IDS_DICT_COL_COMMENT        "Comment"
    IDS_DICT_ADD                "&Add"
    IDS_DICT_EDIT               "&Edit"
    IDS_DICT_DUPLICATE          "D&uplicate"
    IDS_DICT_DELETE             "De&lete"
    IDS_DICT_CLOSE              "&Close"
    IDS_DUPLICATE_SUFFIX        " (copy)"
    IDS_ENTRY_DIALOG_TITLE_ADD  "Add dictionary entry"
    IDS_ENTRY_DIALOG_TITLE_EDIT "Edit dictionary entry"
    IDS_ENTRY_ORIGINAL_LABEL    "Original string:"
    IDS_ENTRY_REPLACEMENT_LABEL "Replacement string:"
    IDS_ENTRY_COMMENT_LABEL     "Comment (Why are you adding this entry?):"
    IDS_ENTRY_CASE_SENSITIVE    "Case sensitive"
    IDS_ENTRY_WHOLE_WORD        "Whole word only"
    IDS_ERROR_TITLE             "Error"
    IDS_ERROR_FILE_CREATE       "Cannot create dictionary file."
    IDS_ERROR_FILE_WRITE        "Error writing to dictionary file."
    IDS_ERROR_FILE_READ         "Error reading dictionary file."
    IDS_ERROR_INVALID_ENTRY     "Original string and replacement string cannot be empty."
    IDS_YES                     "Yes"
    IDS_NO                      "No"
    IDS_GROUP_DICTIONARIES      "Dictionaries"
    // Accent lexicon (accents.json)
    IDS_DICT_TYPE_ACCENTS       "Accent dictionary"
    IDS_DICT_COL_ENTRY          "Entry"
    IDS_DICT_COL_KIND           "Kind"
    IDS_DICT_COL_LANGUAGE       "Language"
    IDS_ACCENT_KIND_WORD        "Word"
    IDS_ACCENT_KIND_VERB        "Verb"
    IDS_ACCENT_LANG_ALL         "All languages"
    IDS_ACCENT_LANG_HR          "Croatian"
    IDS_ACCENT_LANG_SR          "Serbian"
    IDS_ACCENT_LANG_BS          "Bosnian"
    IDS_ACCENT_LANG_SL          "Slovenian"
    IDS_ACCENT_DIALOG_TITLE_ADD "Add accent dictionary entry"
    IDS_ACCENT_DIALOG_TITLE_EDIT"Edit accent dictionary entry"
    IDS_ACCENT_ENTRY_LABEL      "Entry (a word, stem, list of forms or verb with its accent):"
    IDS_ACCENT_KIND_LABEL       "Kind of entry:"
    IDS_ACCENT_LANG_LABEL       "Language:"
    IDS_ACCENT_HELP             "Marks: ' before the stressed vowel (the tone is chosen for you), ^ falling accent, / rising accent, : after a long vowel, * at the end of a stem (kontr'o:l* covers kontróla, kontróle, kontrólom), | between forms (sign'a:l|a|u|om). Verb: the whole stem, = and the class (ur'e:d=i<p for uréditi, urédim), or a root with a long ije (dijel:i for podijeliti)."
    IDS_ERROR_ACCENT_EMPTY      "The entry cannot be empty."
    IDS_ERROR_ACCENT_INVALID    "The entry is not valid: %s"
END

